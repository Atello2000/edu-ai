# ── Serveur ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/jangalai

# ── Sécurité ──────────────────────────────────────────────────────────────────
SESSION_SECRET=chaine-aleatoire-longue-min-32-chars
CSRF_SECRET=autre-chaine-aleatoire-longue-min-32-chars
# Entropie indépendante pour les refresh tokens (7 jours) — OBLIGATOIRE en prod
REFRESH_SECRET=autre-chaine-aleatoire-independante-min-32-chars
# Passer à "true" si le serveur PostgreSQL a un certificat TLS valide
DB_SSL_REJECT_UNAUTHORIZED=false

# ── URLs (Railway : même valeur pour les 3 si monorepo) ───────────────────────
APP_URL=https://jangalai.online
BACKEND_URL=https://jangalai.online
CLIENT_URL=https://jangalai.online

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=votre@email.com
# Limite max d'inscrits en bêta (changer dans Railway sans redéployer)
BETA_USER_LIMIT=100

# ── IA — Provider principal (Groq, gratuit) ───────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Clés supplémentaires pour rotation anti-429 (optionnel)
# GROQ_API_KEY_1=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_API_KEY_2=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_API_KEY_3=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ── IA — Providers alternatifs (optionnel) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Jangalai <noreply@jangalai.app>

# ── Paiement PayTech (Sénégal) ────────────────────────────────────────────────
PAYTECH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
PAYTECH_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
PAYTECH_ENV=test
# Passer à "prod" après le smoke test avec un vrai paiement Wave/Orange Money

# ── Google OAuth (optionnel) ──────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_CALLBACK_URL=https://jangalai-production.up.railway.app/api/auth/google/callback

# ── Push notifications (Web Push) ────────────────────────────────────────────
# Générer avec : node -e "const k=require('web-push').generateVAPIDKeys();console.log(k)"
VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
