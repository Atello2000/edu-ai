{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.jangalai.online/api/:path*" },
    { "source": "/payment-success", "destination": "https://api.jangalai.online/payment-success" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
