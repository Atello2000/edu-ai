{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.jangalai.online/api/:path*" },
    { "source": "/payment-success", "destination": "https://api.jangalai.online/payment-success" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
